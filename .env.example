# ==============================================================================
# QUANTUM ROBOT - ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION CONFIGURATION (PostgreSQL / SQLite / MongoDB)
# ------------------------------------------------------------------------------
# Primary SQL Database Connection URL
# PostgreSQL Local Example: postgresql://postgres:password@localhost:5432/quantum_db
# Supabase / Neon / Render Example: postgresql://user:pass@ep-cool-db.us-east-1.aws.neon.tech/neondb
# SQLite Local Default: sqlite:///./quantum_edu.db
DATABASE_URL=sqlite:///./quantum_edu.db
POSTGRES_URL=

# Individual PostgreSQL Connection Parameters (Optional)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=quantum_db

# MongoDB NoSQL Analytics Connection String (Optional)
# Example: mongodb://localhost:27017/quantum_edu_db
# Atlas Example: mongodb+srv://admin:password@cluster0.mongodb.net/quantum_edu_db
MONGODB_URL=
MONGO_URI=

# ------------------------------------------------------------------------------
# 2. AI AGENTS & LLM API KEYS (Groq, OpenAI, Gemini, Ollama, Anthropic)
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Free tier, fast LLaMA 3.3 70B & Gemma 2 at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Local Offline Ollama (100% Free, zero keys needed, default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI / OpenRouter API Key (GPT-4o, GPT-3.5-turbo for AI Tutor & Code Architect)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai

# Google Gemini API Key (Gemini Pro / Flash models from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Custom AI Agent Service Endpoints & Microservices
AI_ENGINE_URL=http://localhost:8001
AI_THEORY_AGENT_URL=http://localhost:8001/api/ai/explain
AI_CODE_AGENT_URL=http://localhost:8001/api/ai/debug
AI_TUTOR_AGENT_URL=http://localhost:8001/api/ai/explain
VITE_AI_ENGINE_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & THIRD-PARTY SERVICES (Google OAuth & Twilio SMS OTP)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio SMS OTP Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ------------------------------------------------------------------------------
# 4. QUANTUM CLOUD HARDWARE PROVIDERS (IBM Quantum, AWS Braket, qBraid)
# ------------------------------------------------------------------------------
# IBM Quantum Experience API Token (qiskit-ibm-provider)
IBMQ_API_TOKEN=

# AWS Braket Quantum Cloud Credentials (Amazon Braket SDK)
AWS_BRAKET_ACCESS_KEY_ID=
AWS_BRAKET_SECRET_ACCESS_KEY=
AWS_BRAKET_REGION=us-east-1

# qBraid Quantum Cloud Platform Key
QBRAID_API_KEY=

# ------------------------------------------------------------------------------
# 5. FASTAPI BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*
SECRET_KEY=quantum_robot_enterprise_secret_key_2026
